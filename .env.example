# Artificial Consciousness Simulator — Environment Variables
# Copy this file to .env.local and fill in your values.

# Base URL of the application (used for absolute links, SEO, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database connection string (PostgreSQL / Supabase)
# Required for persistent model storage and simulation history
# Example: postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# Vercel Analytics ID (automatically provided by Vercel on deployment)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
